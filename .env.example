# Database
# Use either DATABASE_URL (preferred for production) or individual DB_* variables
DATABASE_URL=postgresql://postgres:your_db_password@localhost:5432/it_assets
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=it_assets

# Auth (REQUIRED)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long
CRON_SECRET_TOKEN=your_cron_secret_token

# Optional: Telegram Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: Microsoft 365 SSO
AZURE_AD_CLIENT_ID=your_azure_ad_client_id
AZURE_AD_CLIENT_SECRET=your_azure_ad_client_secret
AZURE_AD_TENANT_ID=your_azure_ad_tenant_id

# Optional: Redis for distributed rate limiting (production)
REDIS_URL=redis://localhost:6379

# Optional: App Config
PORT=3000
NODE_ENV=development